# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# LLM API (used by Extractor, Verifier, Clarification, Action agents)
# Gemini is free (no billing needed) — get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Local Postgres (Working Guide Step 3 — docker-compose)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=siteops
DB_USER=siteops
DB_PASSWORD=devpassword

# Cloud Run reads PORT automatically; only needed for local runs if you want to override 8080.
PORT=8080
